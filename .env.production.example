# Public deployment template. Fill every blank secret before Compose starts.
APP_ENV=production
WEB_BIND_ADDRESS=127.0.0.1
SERVICE_BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=true
TRUSTED_HOSTS=research.example.com
MODEL_ALLOWED_HOSTS=model-gateway.example.com
MODEL_SETTINGS_ENCRYPTION_KEYS=
AGENT_BACKEND=builtin
LLM_BASE_URL=
LLM_API_KEY=
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_TIMEOUT_SECONDS=12
SEARXNG_MAX_RESULTS=5
CANONICAL_BUNDLE_MODE=akshare
ALLOW_DEMO_DATA=false
ENABLE_PREFECT_FLOWS=false
