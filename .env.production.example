# Public deployment template. Fill every blank secret before Compose starts.
APP_ENV=production
WEB_BIND_ADDRESS=127.0.0.1
SERVICE_BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=true
TRUSTED_HOSTS=research.example.com
MODEL_ALLOWED_HOSTS=model-gateway.example.com
MODEL_SETTINGS_ENCRYPTION_KEYS=
PERSONAL_DATA_ENCRYPTION_KEYS=
PRIVATE_OBJECT_ROOT=/data/private
AGENT_BACKEND=builtin
LLM_BASE_URL=
LLM_API_KEY=
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_TIMEOUT_SECONDS=12
SEARXNG_MAX_RESULTS=5
CANONICAL_BUNDLE_MODE=akshare
ALLOW_DEMO_DATA=false
ENABLE_PREFECT_FLOWS=false
# Optional low-memory HTTPS edge profile. Values are the deployment baseline
# for a manual `docker compose --profile edge up`; with the topology controller
# installed, the administrator-managed system settings take precedence and are
# injected into the compose subprocess (System Settings -> 高级配置 -> 公网边缘网关).
EDGE_DOMAIN=
EDGE_ACME_EMAIL=
EDGE_ACME_CA_SERVER=letsencrypt
EDGE_FRPC_ENABLED=false
# Copy docker/edge-gateway/frpc.toml.example to an untracked private path when
# enabling frpc; the default file is deliberately inert.
EDGE_FRPC_CONFIG_FILE=./docker/edge-gateway/frpc.disabled.toml
# Required only when the optional local topology controller is installed.
TOPOLOGY_CONTROLLER_TOKEN=
