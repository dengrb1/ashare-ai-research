# Local-development template. The canonical copy is .env.local.example.
APP_ENV=development
# Keep local services off the LAN. Override only behind a trusted firewall and
# TLS reverse proxy when testing a physical mobile device.
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
SERVICE_BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=change-this-local-db-password
REDIS_PASSWORD=change-this-local-redis-password
DATABASE_URL=postgresql+psycopg://ashare:change-this-local-db-password@127.0.0.1:5432/ashare
REDIS_URL=redis://:change-this-local-redis-password@127.0.0.1:6379/0
LAKE_ROOT=data/lake
PRIVATE_OBJECT_ROOT=data/private
POLICY_CONFIG_PATH=configs/first_release.v3.json
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=ashare-research
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_SECURE=false
TUSHARE_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-starting
SESSION_COOKIE_NAME=ashare_session
CSRF_COOKIE_NAME=ashare_csrf
SESSION_TTL_HOURS=24
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
COOKIE_SECURE=false
TRUSTED_HOSTS=*
MARKET_CACHE_SECONDS=5
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_SECONDS=12
SEARXNG_MAX_RESULTS=5
MARKET_KLINE_CACHE_SECONDS=300
MARKET_PREFETCH_MAX_WORKERS=4
MARKET_STALE_SECONDS=900
MARKET_TIMEOUT_SECONDS=10
MARKET_HEDGE_DELAY_SECONDS=0.5
CANONICAL_BUNDLE_MODE=akshare
DAILY_RESEARCH_START_HOUR=15
DAILY_RESEARCH_START_MINUTE=5
ALLOW_DEMO_DATA=false
AKSHARE_BUNDLE_SIZE=20
AKSHARE_HISTORY_SESSIONS=280
AKSHARE_FETCH_MAX_ATTEMPTS=2
AKSHARE_FETCH_BACKOFF_SECONDS=1
WORKER_LEASE_SECONDS=900
AGENT_BACKEND=openai_compatible
LLM_BASE_URL=http://127.0.0.1:3688/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
LLM_REASONING_EFFORT=high
LLM_TIMEOUT_SECONDS=90
# 同时发送的投研组件请求数；模型服务限流时可调低。
LLM_AGENT_MAX_CONCURRENCY=4
RESEARCH_EXECUTION_MODE=SERIAL
# Environment-only capacity asserted before the UI may enable DUAL research workers.
MODEL_GATEWAY_MAX_CONCURRENCY=8
MODEL_SETTINGS_ENCRYPTION_KEYS=
# 图片与个人档案服务端包装密钥；可以逗号分隔多个 Fernet 密钥轮换。
PERSONAL_DATA_ENCRYPTION_KEYS=
MIPUSH_APP_SECRET=
MIPUSH_PACKAGE_NAME=
MODEL_ALLOWED_HOSTS=
ENABLE_PREFECT_FLOWS=false
ASHARE_PIPELINE_FACTORY=ashare_ai.orchestration.production:create_pipeline
ASHARE_STAGE_BACKEND_FACTORY=ashare_ai.orchestration.builtin:create_backend
ASHARE_BACKTEST_EXECUTOR_FACTORY=ashare_ai.orchestration.builtin_backtest:create_executor
DEPENDENCY_LOCK_PATH=requirements.lock
GIT_SHA=UNVERSIONED
VITE_API_BASE=/api/v1
VITE_CSRF_COOKIE_NAME=ashare_csrf
