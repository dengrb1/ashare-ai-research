<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ trading_date }} A股 AI 投研日报</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 1100px; color: #17202a; }
    table { width: 100%; border-collapse: collapse; margin: 1rem 0 2rem; }
    th, td { border-bottom: 1px solid #d5d8dc; padding: .55rem; text-align: right; }
    th:first-child, td:first-child { text-align: left; }
    .warning { background: #fff3cd; padding: 1rem; border-left: 4px solid #f0ad4e; }
    .info { background: #eef6ff; padding: 1rem; border-left: 4px solid #4a90e2; }
    .muted { color: #6b7280; }
    .config { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .75rem; margin: 1rem 0; }
    .config div { border: 1px solid #d5d8dc; border-radius: .5rem; padding: .75rem; }
    .config span { display: block; color: #6b7280; font-size: .85rem; }
    .audit { color: #566573; font-size: .9rem; overflow-wrap: anywhere; }
    .table-scroll { overflow-x: auto; }
    .symbol-report { border: 1px solid #d5d8dc; border-radius: .65rem; padding: 1rem; margin: 1rem 0; }
    .symbol-head { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
    .symbol-head h3 { margin: 0 auto 0 0; }
    .tag { display: inline-block; border-radius: 999px; padding: .25rem .65rem; background: #eef6ff; font-size: .82rem; }
    .tag.blocked { background: #fff3cd; }
    .score-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: .5rem; margin: .8rem 0; }
    .score-cards div { background: #f7f9fa; padding: .65rem; border-radius: .4rem; }
    .score-cards span, .score-cards strong { display: block; }
    .score-cards span { color: #6b7280; font-size: .78rem; }
    .component-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .7rem; }
    .component-grid section { background: #f7f9fa; padding: .75rem; border-radius: .4rem; }
    .component-grid h4 { margin: 0 0 .4rem; }
    @media (max-width: 640px) { body { margin: 1rem; } .component-grid { grid-template-columns: 1fr; } th, td { white-space: nowrap; } }
  </style>
</head>
<body>
  {% set scope = research_scope|default('MARKET') %}
  {% set targets = target_symbols|default([]) %}
  {% set budget = research_budget|default({}) %}
  {% set quality = quality_summary|default({'symbol_count': 0, 'fundamental_placeholder_count': 0, 'sentiment_placeholder_count': 0, 'industry_placeholder_count': 0}) %}
  {% set outcome = portfolio_outcome|default({}) %}
  {% set eligible = formal_eligible_symbols|default([]) %}
  {% set exclusions = excluded_symbols|default({}) %}
  {% set risk_code = risk_reason_code|default(None) %}
  {% set risk_message = risk_reason_message|default(None) %}
  <h1>{{ trading_date }} A股 AI 投研日报</h1>
  <p>决策时点：{{ decision_at }}；运行状态：{{ run_status }}</p>
  <p class="info">本报告是正式研究报告；是否允许生成交易建议，由个股数据门禁和全局风控分别决定。</p>
  {% if fused %}<p class="warning">当前为观察模式：{{ risk_message or '正式组合条件未满足' }}。仅输出研究结果，不生成新增模拟仓位。</p>{% endif %}
  <h2>本次研究配置</h2>
  <div class="config">
    <div><span>研究范围</span><strong>{{ {'MARKET': '动态市场股票池', 'WATCHLIST': '我的自选与持仓', 'CUSTOM': '手工指定股票'}.get(scope, scope) }}</strong></div>
    <div><span>指定股票数</span><strong>{{ targets|length if targets else '动态筛选' }}</strong></div>
    <div><span>总资金预算</span><strong>{{ budget.get('total_budget') or '使用系统模拟净值' }}</strong></div>
    <div><span>单股最高投入</span><strong>{{ budget.get('per_symbol_budget') or '遵循 8% 仓位上限' }}</strong></div>
    <div><span>最高可接受股价</span><strong>{{ budget.get('max_stock_price') or '不限' }}</strong></div>
  </div>
  {% if targets %}<p class="muted">指定范围：{{ targets|join('、') }}</p>{% endif %}
  <h2>数据完整性</h2>
  <p class="{{ 'warning' if quality.fundamental_placeholder_count or quality.sentiment_placeholder_count else 'info' }}">
    本次数据包共 {{ quality.symbol_count }} 只证券；基本面占位 {{ quality.fundamental_placeholder_count }} 只，
    新闻/情绪占位 {{ quality.sentiment_placeholder_count }} 只，行业占位 {{ quality.industry_placeholder_count }} 只。
    占位数据不会被当作正式事实，也不会生成可执行组合。
  </p>
  <p class="info">正式可用股票 {{ eligible|length }} 只；被数据门禁排除 {{ exclusions|length }} 只。</p>
  {% if exclusions %}
  <table>
    <thead><tr><th>观察对象</th><th>排除原因码</th></tr></thead>
    <tbody>{% for symbol, reasons in exclusions.items() %}<tr><td>{{ symbol }}</td><td>{{ reasons|join('、') }}</td></tr>{% endfor %}</tbody>
  </table>
  {% endif %}
  <h2>逐股正式研究结论</h2>
  {% for row in report_symbols %}
  <article class="symbol-report">
    <div class="symbol-head">
      <h3>{{ row.name }}（{{ row.symbol }}）</h3>
      <span class="tag {{ '' if row.advice_eligible else 'blocked' }}">{{ '正式可建议' if row.advice_eligible else ('风险禁买' if row.research_status == 'RISK_BLOCKED' else '数据受限') }}</span>
      <span class="tag {{ 'blocked' if row.recommendation == 'NO_BUY' else '' }}">{{ '暂不买入' if row.recommendation == 'NO_BUY' else '可查看模拟方案' }}</span>
    </div>
    <div class="score-cards">
      <div><span>最终分</span><strong>{{ "%.2f"|format(row.score.total_score) }}</strong></div>
      <div><span>基础分</span><strong>{{ "%.2f"|format(row.score.base_total_score) }}</strong></div>
      <div><span>基本面</span><strong>{{ "%.2f"|format(row.score.fundamental_score) }}</strong></div>
      <div><span>技术面</span><strong>{{ "%.2f"|format(row.score.technical_score) }}</strong></div>
      <div><span>情绪面</span><strong>{{ "%.2f"|format(row.score.sentiment_score) }}</strong></div>
      <div><span>数据质量</span><strong>{{ "%.2f"|format(row.score.quality_confidence_score) }}</strong></div>
      <div><span>风险乘数</span><strong>{{ "%.2f"|format(row.score.event_risk_multiplier) }}</strong></div>
      <div><span>数据截止</span><strong>{{ row.score.decision_at }}</strong></div>
    </div>
    <p class="info"><strong>给家人看的总结：</strong>{{ row.plain_language_summary }}</p>
    <div class="component-grid">
      {% for key, label in [('fundamental', '基本面'), ('technical', '技术面'), ('sentiment', '情绪面')] %}
      {% set component = row.components.get(key, {}) %}
      <section><h4>{{ label }}结论</h4>
        <p>得分 {{ component.get('score', '—') }}；置信度 {{ component.get('confidence', '—') }}</p>
        <p>{{ component.get('summary', '该分项依据冻结数据生成，仅用于综合评分。') }}</p>
      </section>
      {% endfor %}
    </div>
    <p><strong>数据完整性：</strong>{{ '通过个股门禁' if row.advice_eligible else '存在限制' }}；<strong>风险等级：</strong>{{ '重大/全局风险' if row.research_status == 'RISK_BLOCKED' else ('受限' if row.research_status == 'FORMAL_WITH_LIMITATIONS' else '常规') }}</p>
    {% if row.exclusion_reasons %}<p class="warning"><strong>暂不买入原因：</strong>{{ row.exclusion_reasons|join('、') }}。不输出虚构买入价、仓位或止损位。</p>{% endif %}
    <p class="audit">证据与来源：{% for component in row.components.values() %}{% for evidence in component.get('evidence', []) %}{{ evidence.source }} / {{ evidence.source_record_id }} / available_at={{ evidence.available_at }}{% if not loop.last %}；{% endif %}{% endfor %}{% endfor %}</p>
  </article>
  {% endfor %}
  <h2>下一交易日模拟组合</h2>
  <div class="table-scroll"><table>
    <thead><tr><th>证券</th><th>权重</th><th>目标股数</th><th>参考价</th></tr></thead>
    <tbody>{% for row in positions %}<tr><td>{{ row.symbol }}</td><td>{{ "%.2f%%"|format(row.weight * 100) }}</td><td>{{ row.target_shares }}</td><td>{{ row.reference_price }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% if not positions %}<p class="info">{{ risk_message or outcome.get('reason_message') or research_only_reason|default(None) or outcome.get('reason', {}).get('message') or '本次未生成模拟组合。' }}</p>{% endif %}
  <h2>风险与审计</h2>
  <ul>{% for risk in risks %}<li>{{ risk }}</li>{% endfor %}{% if risk_code %}<li>{{ risk_code }}：{{ risk_message }}</li>{% endif %}</ul>
  <p class="audit">run_id={{ run_id }} · input_hash={{ input_hash }} · formula={{ formula_version }} · rule={{ trade_rule_version }}</p>
  <p>本报告为模拟研究输出，不构成投资建议，不接入自动实盘下单。</p>
</body>
</html>
