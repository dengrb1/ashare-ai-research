#!/bin/sh
# 若本次提交改动了 web 源码/构建配置，则提前重建 web/dist 并一并暂存，
# 保证每次提交都携带与源码一致的最新前端（Linux 原生版等直接使用 web/dist）。
# 缺少 npm 或 node_modules 时跳过并提示，不阻塞提交。
set -u

changed=$(git diff --cached --name-only -- web/ | grep -vE '^web/dist/' || true)
if [ -z "$changed" ]; then
  exit 0
fi

if ! command -v npm >/dev/null 2>&1 || [ ! -d web/node_modules ]; then
  echo "pre-commit: 检测到 web 源码改动，但缺少 npm 或 web/node_modules，已跳过自动构建。"
  echo "pre-commit: 请手动执行 (cd web && npm ci && npm run build) 并提交 web/dist。"
  exit 0
fi

echo "pre-commit: 检测到 web 源码改动，正在重建 web/dist ..."
if ! (cd web && npm run build >/dev/null 2>&1); then
  echo "pre-commit: web 构建失败，已中止提交。" >&2
  exit 1
fi

git add web/dist
